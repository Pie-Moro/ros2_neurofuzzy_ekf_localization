<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo sensor & actuator plugins for the customised TurtleBot3 Burger.

    Included by tb3_custom.urdf.xacro which defines the ${namespace}
    xacro property, so all link / joint / frame references here use
    that same prefix.

    Sensors
    ======
    1. IMU        — libgazebo_ros_imu_sensor.so   → /imu/data
    2. GPS        — libgazebo_ros_gps_sensor.so   → /gps/fix

    NOTE: The base_scan link in the URDF is kept only for its visual
    mesh (so the robot still looks correct). There is intentionally
    NO LiDAR sensor plugin — this project does not use a laser scanner.

    Actuator
    ======-
    3. Diff-drive — libgazebo_ros_diff_drive.so   → /cmd_vel, /odom
  -->

  <!-- ═══════════════════════════════════════════════
       1.  IMU  (BMI160-like — 100 Hz)
       Now uses ${namespace}imu_link so the TF and
       gazebo reference stay consistent under any
       namespace.
  ═══════════════════════════════════════════════════ -->
  <gazebo reference="${namespace}imu_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="tb3_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>true</initial_orientation_as_reference>
        <frame_name>${namespace}imu_link</frame_name>
      </plugin>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.000186</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.000186</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.000186</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════
       2.  GPS  (5 Hz, ~0.32 m horizontal stddev)
       Now uses ${namespace}gps_link.
  ═══════════════════════════════════════════════════ -->
  <gazebo reference="${namespace}gps_link">
    <sensor name="tb3_gps" type="gps">
      <always_on>true</always_on>
      <update_rate>5.0</update_rate>
      <plugin name="tb3_gps_plugin" filename="libgazebo_ros_gps_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=gps/fix</remapping>
        </ros>
        <frame_name>${namespace}gps_link</frame_name>
      </plugin>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.3162</stddev></noise>
          </horizontal>
          <vertical>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.3162</stddev></noise>
          </vertical>
        </position_sensing>
      </gps>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════
       3.  Differential Drive  (30 Hz)
       Fixes vs. original:
         - left/right joint names use ${namespace} so
           the plugin finds the joints in any namespace.
         - robot_base_frame uses ${namespace}.
         - publish_odom_tf = true so the odom → base_footprint
           TF is published  and the package works standalone.
           Switch to false if/when you add an EKF node
           (e.g. robot_localization) that will own that
           edge of the TF tree.
  ═══════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="tb3_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>

      <left_joint>${namespace}wheel_left_joint</left_joint>
      <right_joint>${namespace}wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>   <!-- set false when an EKF takes over -->
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>${namespace}base_footprint</robot_base_frame>

      <covariance_x>0.045796</covariance_x>
      <covariance_y>0.045796</covariance_y>
      <covariance_yaw>0.110020</covariance_yaw>
    </plugin>
  </gazebo>

</robot>
